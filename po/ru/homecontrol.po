msgid "The rule will start working again automatically when the time is up."
msgstr "Правило снова заработает автоматически по истечении времени."

#: htdocs/luci-static/resources/view/homecontrol/rules.js
msgid "Resume immediately"
msgstr "Возобновить сейчас"

#: htdocs/luci-static/resources/view/homecontrol/rules.js
msgid "Block access to sites and resources for the whole network. Optionally limit each rule to a time window — outside the window the sites are reachable again automatically."
