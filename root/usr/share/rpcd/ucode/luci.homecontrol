#!/usr/bin/ucode
/*
 * SPDX-License-Identifier: GPL-2.0-only
 *
 * HomeControl rpcd backend: ubus object "luci.homecontrol" for the LuCI app.
 * Deployed to /usr/share/rpcd/ucode/luci.homecontrol. Executed by rpcd's
 * ucode interpreter, which runs the file as a program and takes the returned
 * object. To syntax-check locally, wrap the source in a function body (top
 * level `return` is rpcd-specific, not valid in plain ucode execution).
 */

'use strict';

import { access, readfile, popen, open, writefile } from 'fs';
import {
	RUN_DIR, EVENTS_PATH, LOG_PATH, CONF,
	get_sections, main_opt, add_event,
	read_temps, write_temps, atomic_write,
	client_states, read_wifi_temps, wifi_temp_set, wifi_temp_clear,
	schedule_active, get_schedules, active_rules, vercmp
} from '/etc/homecontrol/scripts/homecontrol.uc';

const VERSION_FILE = '/usr/share/homecontrol/version';
const REPO = 'ezdizzy/HomeControl';
const UPDATE_TMP = '/tmp/homecontrol-update';

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function restart_apply() {
	/* Run the enforcer detached so rpcd never blocks on it. */
	system(`( ucode -L /etc/homecontrol/scripts /etc/homecontrol/scripts/apply.uc >/dev/null 2>&1 ) &`);
}

function now_epoch() {
	return time();
}

function current_version() {
	return access(VERSION_FILE) ? trim(readfile(VERSION_FILE) || '') : 'dev';
}

/* Fetch the latest GitHub release. Returns {tag, assets:[{name,url}]} or null. */
function github_latest() {
	const fd = popen(`wget -qO- --timeout=10 "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null`);
	if (!fd)
		return null;
	const raw = fd.read('all');
	fd.close();
	let rel = null;
	try { rel = json(raw); } catch (e) { rel = null; }
	if (!rel || !rel.tag_name)
		return null;
	const assets = [];
	const list = rel.assets || [];
	for (let i = 0; i < length(list); i++) {
		const a = list[i];
		if (a.name && a.browser_download_url)
			push(assets, { name: a.name, url: a.browser_download_url });
	}
	return { tag: rel.tag_name, assets: assets };
}

function pkg_ext() {
	/* Portable detection: apk may live in /bin, /sbin or /usr/bin
	 * (25.12 has /usr/bin/apk). opkg is the only other supported mgr. */
	const fd = popen('command -v apk 2>/dev/null');
	const p = fd ? trim((fd.read('all') || '')) : '';
	if (fd)
		fd.close();
	return length(p) ? 'apk' : 'ipk';
}

function status_overview() {
	const states = client_states(time());

	/* online detection via /proc/net/arp */
	const arp = {};
	const raw = readfile('/proc/net/arp') || '';
	const lines = split(trim(raw), '\n');
	for (let i = 1; i < length(lines); i++) {
		const f = split(trim(lines[i]), /\s+/);
		if (length(f) >= 6 && f[3] != '00:00:00:00:00:00')
			arp[f[0]] = f[3];
	}
	for (let i = 0; i < length(states); i++)
		states[i].online = (states[i].ip && (states[i].ip in arp)) ? true : false;

	let blocked = 0, allowed = 0, temp = 0;
	for (let i = 0; i < length(states); i++) {
		if (states[i].blocked) {
			blocked++;
			if (states[i].reason === 'temp')
				temp++;
		} else {
			allowed++;
		}
	}

	/* rules paused-for info for the UI */
	const now_ts = time();
	const all_rules = get_sections('rule');
	const paused_rules = {};
	for (let i = 0; i < length(all_rules); i++) {
		const du = int(all_rules[i].disabled_until) || 0;
		if (du > now_ts)
			paused_rules[all_rules[i].id] = du;
	}

	/* active per-client DNS filter instances (client id -> port) */
	const dnsf = {};
	const insts_path = RUN_DIR + '/dnsf/instances.json';
	if (access(insts_path)) {
		try {
			const insts = json(readfile(insts_path) || '[]');
			for (let i = 0; i < length(insts); i++)
				dnsf[insts[i].id] = insts[i].port;
		} catch (e) { /* ignore corrupt state */ }
	}

	return {
		enabled: main_opt('enabled', '0') === '1',
		paused: main_opt('paused', '0') === '1',
		version: current_version(),
		clients_total: length(states),
		blocked: blocked,
		allowed: allowed,
		temp: temp,
		schedules: length(get_schedules()),
		clients: states,
		rules_paused: paused_rules,
		dns_filters: dnsf
	};
}

const methods = {

	status: {
		call: function(req) {
			return status_overview();
		}
	},

	apply: {
		call: function(req) {
			restart_apply();
			return { result: true };
		}
	},

	/* Pause / resume all enforcement (parents' override switch). */
	set_paused: {
		args: { paused: 'paused' },
		call: function(req) {
			const p = (req.args?.paused === true || req.args?.paused === '1') ? '1' : '0';
			system(`uci -q set ${CONF}.main.paused='${p}'`);
			system(`uci -q commit ${CONF}`);
			add_event('system', '', (p === '1') ? 'enforcement paused' : 'enforcement resumed');
			restart_apply();
			return { result: true, paused: p === '1' };
		}
	},

	/* Quick block / unblock a client by section id. */
	client_set_blocked: {
		args: { id: 'id', blocked: 'blocked' },
		call: function(req) {
			const id = req.args?.id;
			if (!id)
				return { result: false, error: 'missing id' };
			const b = (req.args?.blocked === true || req.args?.blocked === '1') ? '1' : '0';
			if (b === '1') {
				const secs = get_sections('client');
				let found = null;
				for (let i = 0; i < length(secs); i++)
					if (secs[i].id === id)
						found = secs[i];
				if (!found)
					return { result: false, error: 'unknown client id' };
				if (!length(found.ip || '') && !length(found.mac || ''))
					return { result: false, error: 'client has no ip/mac — add an address first' };
			}
			system(`uci -q set ${CONF}.${id}.blocked='${b}'`);
			system(`uci -q commit ${CONF}`);
			const fd = popen(`uci -q get ${CONF}.${id}.name 2>/dev/null`);
			const name = fd ? trim((fd.read('all') || '')) : id;
			if (fd) fd.close();
			add_event((b === '1') ? 'block' : 'allow', name || id, (b === '1') ? 'blocked manually' : 'unblocked');
			restart_apply();
			return { result: true };
		}
	},

	/* Temporary block: minutes (any positive number). */
	client_temp_block: {
		args: { id: 'id', minutes: 'minutes' },
		call: function(req) {
			const id = req.args?.id;
			if (!id)
				return { result: false, error: 'missing id' };
			const mins = int(req.args?.minutes) || 60;
			if (mins < 1 || mins > 60 * 24 * 30)
				return { result: false, error: 'bad minutes' };
			const fd1 = popen(`uci -q get ${CONF}.${id}.ip 2>/dev/null`);
			const ip_v = fd1 ? trim((fd1.read('all') || '')) : '';
			if (fd1) fd1.close();
			const fd2 = popen(`uci -q get ${CONF}.${id}.mac 2>/dev/null`);
			const mac_v = fd2 ? trim((fd2.read('all') || '')) : '';
			if (fd2) fd2.close();
			if (!length(ip_v) && !length(mac_v))
				return { result: false, error: 'client has no ip/mac' };
			const temps = read_temps();
			const until = now_epoch() + mins * 60;
			if (length(ip_v))
				temps[ip_v] = until;
			if (length(mac_v))
				temps[mac_v] = until;
			write_temps(temps);
			const fd3 = popen(`uci -q get ${CONF}.${id}.name 2>/dev/null`);
			const name = fd3 ? trim((fd3.read('all') || '')) : id;
			if (fd3) fd3.close();
			add_event('temp', name || id, `temporary block for ${mins} min`);
			restart_apply();
			return { result: true, until: until };
		}
	},

	client_temp_unblock: {
		args: { id: 'id' },
		call: function(req) {
			const id = req.args?.id;
			if (!id)
				return { result: false, error: 'missing id' };
			const fd1 = popen(`uci -q get ${CONF}.${id}.ip 2>/dev/null`);
			const ip_v = fd1 ? trim((fd1.read('all') || '')) : '';
			if (fd1) fd1.close();
			const fd2 = popen(`uci -q get ${CONF}.${id}.mac 2>/dev/null`);
			const mac_v = fd2 ? trim((fd2.read('all') || '')) : '';
			if (fd2) fd2.close();
			const temps = read_temps();
			if (length(ip_v))
				delete temps[ip_v];
			if (length(mac_v))
				delete temps[mac_v];
			write_temps(temps);
			add_event('temp', id, 'temporary block removed');
			restart_apply();
			return { result: true };
		}
	},

	/* Add a client by hand: name + ip and/or mac. */
	client_add: {
		args: { name: 'name', ip: 'ip', mac: 'mac' },
		call: function(req) {
			const name = trim(req.args?.name || '');
			const ip = trim(req.args?.ip || '');
			const mac = trim(req.args?.mac || '');
			if (!name && !ip && !mac)
				return { result: false, error: 'nothing to add' };
			if (ip && !match(ip, /^(\d{1,3}\.){3}\d{1,3}$/))
				return { result: false, error: 'invalid ip' };
			if (mac && !match(mac, /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/))
				return { result: false, error: 'invalid mac' };
			const existing = get_sections('client');
			for (let i = 0; i < length(existing); i++) {
				const e = existing[i];
				if (ip && e.ip === ip)
					return { result: false, error: 'a client with this IP already exists' };
				if (mac && e.mac && lc(e.mac) === lc(mac))
					return { result: false, error: 'a client with this MAC already exists' };
			}
			/* uci add prints the new section id to stdout; use popen. */
			const fd = popen(`uci -q add ${CONF} client`);
			const newid = fd ? trim((fd.read('line') || '')) : '';
			if (fd)
				fd.close();
			if (!length(newid))
				return { result: false, error: 'uci add failed' };
			if (length(name))
				system(`uci -q set ${CONF}.${newid}.name='${replace(name, "'", '')}'`);
			if (length(ip))
				system(`uci -q set ${CONF}.${newid}.ip='${ip}'`);
			if (length(mac))
				system(`uci -q set ${CONF}.${newid}.mac='${mac}'`);
			system(`uci -q set ${CONF}.${newid}.blocked='0'`);
			system(`uci -q commit ${CONF}`);
			add_event('system', name || ip || mac, 'client added');
			restart_apply();
			return { result: true, id: newid };
		}
	},

	client_delete: {
		args: { id: 'id' },
		call: function(req) {
			const id = req.args?.id;
			if (!id)
				return { result: false, error: 'missing id' };
			system(`uci -q delete ${CONF}.${id}`);
			system(`uci -q commit ${CONF}`);
			add_event('system', id, 'client deleted');
			restart_apply();
			return { result: true };
		}
	},

	/* Wi-Fi status: radios, ifaces, temp off markers. */
	wifi_status: {
		call: function(req) {
			const fd = popen(`ubus call network.wireless status 2>/dev/null`);
			if (!fd)
				return { radios: [], temps: {} };
			const raw = fd.read('all');
			fd.close();
			let st = null;
			try { st = json(raw); } catch (e) { st = null; }
			if (!st)
				return { radios: [], temps: {} };

			const out = [];
			const radio_names = [];
			for (let radio in st)
				push(radio_names, radio);
			for (let ri = 0; ri < length(radio_names); ri++) {
				const radio = radio_names[ri];
				const r = st[radio];
				const ifaces = [];
				const confs = r.interfaces || [];
				for (let i = 0; i < length(confs); i++) {
					const cf = confs[i];
					const cfg = cf.config || {};
					const ifdis = (cfg.disabled === true);
					push(ifaces, {
						id: cf.section || '',
						ssid: cfg.ssid || '',
						up: (r.up === true) && !ifdis,
						disabled: ifdis
					});
				}
				push(out, { radio: radio, up: r.up === true, ifaces: ifaces });
			}
			return { radios: out, temps: read_wifi_temps() };
		}
	},

	/* Toggle a wireless iface on/off (persistent, user's choice). */
	wifi_set: {
		args: { iface: 'iface', disabled: 'disabled' },
		call: function(req) {
			const iface = req.args?.iface;
			if (!iface || !match(iface, /^[A-Za-z0-9_]+$/))
				return { result: false, error: 'bad iface' };
			const dis = (req.args?.disabled === true || req.args?.disabled === '1') ? '1' : '0';
			if (dis === '1') {
				system(`uci -q set wireless.${iface}.disabled='1'`);
				add_event('wifi', iface, 'turned off');
			} else {
				system(`uci -q delete wireless.${iface}.disabled`);
				system(`rm -f '${RUN_DIR}/wifi.off.${iface}'`);
				add_event('wifi', iface, 'turned on');
			}
			system(`uci -q commit wireless`);
			system(`wifi reload 2>/dev/null`);
			return { result: true };
		}
	},

	/* Temporarily turn a Wi-Fi iface off; auto re-enables after minutes. */
	wifi_temp_off: {
		args: { iface: 'iface', minutes: 'minutes' },
		call: function(req) {
			const iface = req.args?.iface;
			if (!iface || !match(iface, /^[A-Za-z0-9_]+$/))
				return { result: false, error: 'bad iface' };
			const mins = int(req.args?.minutes) || 60;
			if (mins < 1 || mins > 60 * 24 * 30)
				return { result: false, error: 'bad minutes' };
			wifi_temp_set(iface, now_epoch() + mins * 60);
			add_event('wifi', iface, `temporarily off for ${mins} min`);
			restart_apply();
			return { result: true };
		}
	},

	wifi_temp_on: {
		args: { iface: 'iface' },
		call: function(req) {
			const iface = req.args?.iface;
			if (!iface || !match(iface, /^[A-Za-z0-9_]+$/))
				return { result: false, error: 'bad iface' };
			wifi_temp_clear(iface);
			add_event('wifi', iface, 'temporary off removed');
			restart_apply();
			return { result: true };
		}
	},

	/* Events journal (last N). */
	events: {
		args: { limit: 'limit' },
		call: function(req) {
			let events = [];
			if (access(EVENTS_PATH)) {
				try { events = json(readfile(EVENTS_PATH)); } catch (e) { events = []; }
			}
			const limit = int(req.args?.limit) || 100;
			const start = max(0, length(events) - limit);
			const out = [];
			for (let i = start; i < length(events); i++)
				push(out, events[i]);
			return { events: out };
		}
	},

	/* Clear the events journal. */
	events_clear: {
		call: function(req) {
			if (access(EVENTS_PATH))
				system(`rm -f '${EVENTS_PATH}'`);
			add_event('system', '', 'events journal cleared');
			return { result: true };
		}
	},

	log_tail: {
		args: { lines: 'lines' },
		call: function(req) {
			const n = int(req.args?.lines) || 50;
			const fd = popen(`tail -n ${n} ${shellquote(LOG_PATH)} 2>/dev/null`);
			if (!fd)
				return { content: '' };
			const raw = fd.read('all');
			fd.close();
			return { content: raw || '' };
		}
	},

	/* ── Self-update (GitHub releases) ────────────────────────────── */

	update_check: {
		call: function(req) {
			const cur = current_version();
			const fd = popen(`wget -qO- --timeout=10 "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null`);
			if (!fd)
				return { result: false, error: 'fetch failed' };
			const raw = fd.read('all');
			fd.close();
			let rel = null;
			try { rel = json(raw); } catch (e) { rel = null; }
			if (!rel || !rel.tag_name)
				return { result: false, error: 'no release data' };
			const latest = replace(rel.tag_name, /^v/, '');
			return {
				result: true,
				current: cur,
				latest: rel.tag_name,
				update_available: vercmp(latest, cur) > 0
			};
		}
	},

	update_perform: {
		call: function(req) {
			const ext = pkg_ext();
			const fd = popen(`wget -qO- --timeout=10 "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null`);
			if (!fd)
				return { result: false, error: 'fetch failed' };
			const raw = fd.read('all');
			fd.close();
			let rel = null;
			try { rel = json(raw); } catch (e) { rel = null; }
			if (!rel || !rel.assets)
				return { result: false, error: 'no release data' };

			/* main package asset */
			let url = null;
			let i18n_url = null;
			/* NOTE: ucode match() with a STRING pattern is broken on this
			 * build (returns null even for present substrings) — use regex
			 * literals or explicit substring checks. Here ext is dynamic,
			 * so do plain prefix/suffix matching. */
			const aprefix = 'luci-app-homecontrol_';
			const asuffix = '_all.' + ext;
			const iprefix = 'luci-i18n-homecontrol-ru_';
			for (let i = 0; i < length(rel.assets); i++) {
				const a = rel.assets[i];
				if (a.name && length(a.name) > length(aprefix) + length(asuffix) &&
					substr(a.name, 0, length(aprefix)) === aprefix &&
					substr(a.name, length(a.name) - length(asuffix)) === asuffix) {
					url = a.browser_download_url;
				}
				/* i18n ru asset: same version, best effort (optional) */
				if (a.name && length(a.name) > length(iprefix) + length(asuffix) &&
					substr(a.name, 0, length(iprefix)) === iprefix &&
					substr(a.name, length(a.name) - length(asuffix)) === asuffix) {
					i18n_url = a.browser_download_url;
				}
			}
			if (!url)
				return { result: false, error: 'no package asset in release' };

			const dl = `${UPDATE_TMP}.${ext}`;
			const dl_i18n = `${UPDATE_TMP}-ru.${ext}`;
			system(`wget -qO ${shellquote(dl)} --timeout=60 ${shellquote(url)} 2>/dev/null`);
			if (!access(dl))
				return { result: false, error: 'download failed' };
			if (i18n_url)
				system(`wget -qO ${shellquote(dl_i18n)} --timeout=60 ${shellquote(i18n_url)} 2>/dev/null`);
			const have_i18n = !!i18n_url && access(dl_i18n);

			add_event('update', '', (have_i18n
				? `downloading and installing ${ext} update (+i18n ru)`
				: `downloading and installing ${ext} update`));
			/* Synchronous install (like re-homeproxy app_install_pkg): the UI
			 * reloads the page itself when this returns. apk/opkg need a timeout
			 * so a hung transaction cannot block rpcd forever. */
			let rc;
			if (ext === 'apk')
				rc = system((have_i18n
					? `apk add --allow-untrusted ${dl} ${dl_i18n}`
					: `apk add --allow-untrusted ${dl}`) + ' >/tmp/homecontrol-update.log 2>&1', 120000);
			else
				rc = system((have_i18n
					? `opkg install --force-reinstall ${shellquote(dl)} ${shellquote(dl_i18n)}`
					: `opkg install --force-reinstall ${shellquote(dl)}`) + ' >/tmp/homecontrol-update.log 2>&1', 120000);
			system(`rm -f ${shellquote(dl)} ${shellquote(dl_i18n)}`);
			if (rc !== 0) {
				const logc = access('/tmp/homecontrol-update.log') ? readfile('/tmp/homecontrol-update.log') : '';
				return {
					result: false,
					error: 'package installation failed (see journal/service log)',
					log: logc
				};
			}
			add_event('update', '', 'update installed successfully');
			return { result: true, installed: true, version: current_version() };
		}
	},

	update_status: {
		call: function(req) {
			const logc = access('/tmp/homecontrol-update.log') ? readfile('/tmp/homecontrol-update.log') : '';
			return {
				version: current_version(),
				log: logc
			};
		}
	}

};

return { 'luci.homecontrol': methods };
